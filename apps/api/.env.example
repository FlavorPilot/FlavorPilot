NODE_ENV=development
API_HOST=0.0.0.0
PORT=
API_PORT=4000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
DATABASE_URL=
DATABASE_SSL=auto
DATABASE_POOL_SIZE=10
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Disabled by default. Requires the recipe/AI migration, database and server key.
AI_ENABLED=false
# Administrator sessions require an authenticator code. Production cannot disable this.
ADMIN_REQUIRE_MFA=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Comma-separated explicitly approved account UUIDs; no automatic owner promotion.
AI_PILOT_USER_IDS=
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=50
