NODE_ENV=development
API_HOST=0.0.0.0
# Optional platform-assigned port; takes precedence over API_PORT.
PORT=
API_PORT=4000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# Direct PostgreSQL or Supabase pooler connection string.
# Without it, health and flavor analysis still work; persistence returns 503.
DATABASE_URL=
DATABASE_SSL=auto
DATABASE_POOL_SIZE=10

# Used by the Nest authorization guard to validate Supabase bearer tokens.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional AI narrative layer. It never calculates scores.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
